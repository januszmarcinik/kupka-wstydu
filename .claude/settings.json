{
  "permissions": {
    "allow": [
      "Bash(node scripts/check-web.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./hltb/**)",
      "Edit(./hltb/**)",
      "Write(./hltb/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node scripts/check-web.mjs --hook" }
        ]
      }
    ]
  }
}
